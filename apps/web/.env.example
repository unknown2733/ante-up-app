# Public Vite build inputs only. Never place secrets here.
# Empty API URL selects the explicitly labeled local fixture experience.
VITE_API_BASE_URL=
VITE_ALLOW_FIXTURE_API=false
VITE_WALLET_CLUSTER=devnet
# Public finalized-read RPC endpoint for pre-sign financial instruction verification.
# Leave empty to keep financial signing unavailable.
VITE_SOLANA_RPC_URL=
# Android MWA uses the HTTPS page origin when this is empty.
VITE_MWA_APP_URI=
# Development proxy target; production uses API_ORIGIN in serve-web.mjs.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
