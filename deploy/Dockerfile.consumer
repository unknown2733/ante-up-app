# Incremental release, only when the base has the same package lockfiles.
# The clean-build path remains deploy/Dockerfile.
ARG BASE_IMAGE=ante-up:wallet-reconcile-20261013
FROM ${BASE_IMAGE}
USER root
COPY . /app
WORKDIR /app
ENV VITE_API_BASE_URL=/api VITE_ALLOW_FIXTURE_API=false VITE_WALLET_CLUSTER=devnet VITE_SOLANA_RPC_URL=https://api.devnet.solana.com VITE_MWA_APP_URI=https://ante-up.fun
RUN npm --prefix clients/chain run build && npm --prefix services/api run check && npm --prefix apps/web run build && node scripts/assert-live-web-build.mjs
USER node
