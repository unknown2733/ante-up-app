# Load explicitly; values here are placeholders and contain no keys.
# Live mode must use the same program, registry and SQLite file as the indexer.
ANTE_UP_MODE=devnet
ANTE_UP_PROGRAM_ID=
ANTE_UP_RPC_URL=
ANTE_UP_INDEX_DB=./.runtime/indexer.sqlite
ANTE_UP_MARKETS_PATH=./.runtime/markets.json
PORT=8787
# Optional, capped Devnet SOL assistance. Disabled by default. Use a dedicated
# small funder, separate from publisher, keeper, SAS and protocol authorities.
ANTE_UP_VISITOR_SOL_ENABLED=false
# Required only when enabled; 64-byte Solana keypair JSON kept outside Git.
ANTE_UP_VISITOR_SOL_KEYPAIR_FILE=
ANTE_UP_VISITOR_SOL_FUNDER_ADDRESS=
# All values are lamports. Hard ceilings: 50m per grant, 500m/day, 10b total.
ANTE_UP_VISITOR_SOL_GRANT_LAMPORTS=
ANTE_UP_VISITOR_SOL_DAILY_CAP_LAMPORTS=
ANTE_UP_VISITOR_SOL_TOTAL_CAP_LAMPORTS=
