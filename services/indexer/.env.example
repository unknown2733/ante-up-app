# Load explicitly with Node --env-file or your process manager.
# Set the real deployed identity and RPC before enabling polling.
ANTE_UP_CLUSTER=devnet
ANTE_UP_PROGRAM_ID=
ANTE_UP_RPC_URL=
ANTE_UP_INDEX_DB=./.runtime/indexer.sqlite
# C/E single-writer repositories; refreshed before each poll/retry.
ANTE_UP_CANDIDATES_PATH=./.runtime/collection/candidates.json
ANTE_UP_PROOFS_PATH=./.runtime/evidence/jobs.json
ANTE_UP_POLL_INTERVAL_MS=5000
# Optional custom decoder. Empty selects the generated decoder and built-in
# finalized account/candidate/proof resolvers. No credentials belong in Git.
ANTE_UP_DECODER_MODULE=
